# =============================================================================
# SaltLens DSS backend environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- General ---------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# --- Authentication (Module 1) ---------------------------------------------
# The API is OPEN ACCESS: no route requires a token yet. The secret is still
# required as a safe default, so that when Module 1 is wired the configuration
# is already trustworthy. It must be a strong random value; in production the
# process refuses to start while it is empty or set to the old dev placeholder.
# Note that an *empty* value and the documented example below are both treated
# as insecure -- the example placeholder is intentionally not usable verbatim,
# so a copy that ignores the note fails fast instead of silently signing tokens.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- MongoDB Atlas ----------------------------------------------------------
MONGODB_URI=
DATABASE_NAME=saltlens
MONGODB_CONNECT_TIMEOUT_MS=2500
MONGODB_APP_NAME=saltlens-dss

# Set to 1 to build the shared database manager unconfigured, so the process
# cannot reach MongoDB at all. tests/conftest.py sets this for the whole backend
# suite: the suite must never touch the cluster your MONGODB_URI points at. Leave
# it unset for normal development and production runs, where MONGODB_URI above is
# what the application connects with.
SALTLENS_TEST_NO_DATABASE=

# --- Machine learning --------------------------------------------------------
ML_MODEL_DIR=../ml/models
ENABLE_MOCK_SIMULATIONS=false

# --- Rate limiting -----------------------------------------------------------
# There is no account layer yet, so the API throttles per source IP. On by
# default. RATE_LIMIT_ENABLED=false removes the limiter entirely; forced to stay
# true in production by the startup configuration guard.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_HEAVY_PER_MINUTE=120
# Compute-heavy endpoints (training, evaluation, explanation, simulation sets,
# dataset building, prediction) share a tighter budget on top of the general one.
RATE_LIMIT_HEAVY_PREFIXES=/api/ml,/api/evaluate,/api/explain,/api/simulator,/api/datasets,/api/risk/predict,/api/decisions/predict

# --- Sensor ingestion (Modules 3 and 4) ---------------------------------------
# Leave false. No sensor gateway is connected to this deployment, and enabling
# this flag would let a reading claim a provenance that no instrument produced.
# While it is false, data_source="sensor" is refused with HTTP 409 on both
# /api/observations/ and /api/weather/, and
# POST /api/observations/ingest/sensor reports HTTP 501.
SENSOR_INGEST_ENABLED=false

# --- Weather API providers (Module 4) -----------------------------------------
# There is deliberately no environment variable here. Whether a forecast can be
# fetched is decided by what is registered in the provider registry, not by a
# flag that could disagree with reality: an enabled switch with no provider
# behind it would report an availability that does not exist.
#
# The registry ships empty, so GET /api/weather/providers reports count 0 and
# POST /api/weather/ingest/{provider} returns HTTP 404. To connect a real
# service, implement the WeatherProvider protocol in
# app/services/weather_providers.py and register it at start-up; put that
# service's credentials in this file. See README.md, "Adding a real weather API".
